{
  "expo": {
    "name": "IFAM Eventos",
    "slug": "ifam-eventos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ifameventos",
    "splash": {
      "backgroundColor": "#1B5E20"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.ifam.eventos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20"
      },
      "package": "br.edu.ifam.eventos",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O app precisa de acesso à câmera para escanear o QR Code de presença nas palestras do IFAM."
        }
      ]
    ]
  }
}
